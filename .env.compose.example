# Production-like Docker Compose environment.
# Copy to .env.compose and replace placeholders locally or in your deployment runner.
# Do not commit .env.compose or any real credentials.

# Loopback by default for local safety. Set to 0.0.0.0 only behind a trusted proxy/firewall.
BIND_HOST=127.0.0.1

# Image tags
ECOMMERCE_IMAGE_TAG=dev
WEB_IMAGE_TAG=main
MINIMAX_BRIDGE_IMAGE_TAG=main
VERSION=v0.5.0
COMMIT=local

# Published ports
MC_API_HOST_PORT=8080
WEB_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
MINIMAX_BRIDGE_HOST_PORT=8090

# PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=replace-with-strong-local-password

# Redis
ECOMMERCE_REDIS_DB=0
ECOMMERCE_REDIS_KEY_PREFIX=ec:prod:
ECOMMERCE_EVENTBUS_DRIVER=redis
ECOMMERCE_EVENTBUS_REDIS_DB=0
ECOMMERCE_EVENTBUS_CHANNEL_SYNC=ec.sync.events
ECOMMERCE_EVENTBUS_CHANNEL_DLQ=ec.sync.deadletter

# API and frontend boundary
ECOMMERCE_API_TOKEN=replace-with-api-token-or-leave-blank-for-local-only
ECOMMERCE_ALLOWED_ORIGIN=http://127.0.0.1:3000
MC_API_BASE_URL=http://mc-api:8080
FLEET_AI_BRIDGE_URL=

# WooCommerce integration. Keep blank for dry-run/no-op sync.
ECOMMERCE_WC_STORE_URL=
ECOMMERCE_WC_BASE_URL=
ECOMMERCE_WC_CONSUMER_KEY=
ECOMMERCE_WC_CONSUMER_SECRET=
ECOMMERCE_WC_WEBHOOK_SECRET=
ECOMMERCE_SYNC_MODE=once
ECOMMERCE_SYNC_DRY_RUN=true

# AI bridge integration. Do not point directly at MiniMax from app services.
ECOMMERCE_AI_BRIDGE_URL=
ECOMMERCE_AI_MODEL=

# Optional minimax-openai-bridge profile placeholders.
MINIMAX_API_KEY_1=
MINIMAX_API_KEY_2=
MINIMAX_BASE_URL=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password

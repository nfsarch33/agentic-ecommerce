# Production-like Docker Compose environment.
# Copy to .env.compose and replace placeholders locally or in your deployment runner.
# Do not commit .env.compose or any real credentials.

# Loopback by default for local safety. Set to 0.0.0.0 only behind a trusted proxy/firewall.
BIND_HOST=127.0.0.1

# Image tags
ECOMMERCE_IMAGE_TAG=dev
WEB_IMAGE_TAG=main
MINIMAX_BRIDGE_IMAGE_TAG=main
VERSION=v1.0.0
COMMIT=local

# Published ports
MC_API_HOST_PORT=8080
WEB_HOST_PORT=3000
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
MINIMAX_BRIDGE_HOST_PORT=8090
AGENT_WORKER_METRICS_HOST_PORT=8082

# PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=replace-with-strong-local-password

# Redis
ECOMMERCE_REDIS_DB=0
ECOMMERCE_REDIS_KEY_PREFIX=ec:prod:
ECOMMERCE_EVENTBUS_DRIVER=redis
ECOMMERCE_EVENTBUS_REDIS_DB=0
ECOMMERCE_EVENTBUS_CHANNEL_SYNC=ec.sync.events
ECOMMERCE_EVENTBUS_CHANNEL_DLQ=ec.sync.deadletter

# Temporal local workflow infrastructure. The compose profile runs a dev-only
# Temporal server and UI on loopback; no credentials are required or committed.
TEMPORAL_IMAGE_TAG=latest
TEMPORAL_GRPC_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8233
ECOMMERCE_TEMPORAL_ADDRESS=temporal:7233
ECOMMERCE_TEMPORAL_NAMESPACE=default
ECOMMERCE_TEMPORAL_TASK_QUEUE=ec-workflows
TEMPORAL_WORKER_IMAGE=ghcr.io/nfsarch33/agentic-ecommerce:dev-temporal-worker

# Cloud readiness and optional OpenTelemetry HTTP spans.
ECOMMERCE_READINESS_TIMEOUT=2s
ECOMMERCE_SHUTDOWN_TIMEOUT=10s
ECOMMERCE_OTEL_ENABLED=false

# Agent scheduler worker. It only runs when the compose workers profile is enabled.
ECOMMERCE_AGENT_WORKER_ENABLED=true
ECOMMERCE_AGENT_WORKER_RUN_ONCE=false
ECOMMERCE_AGENT_WORKER_CONCURRENCY=1
ECOMMERCE_AGENT_WORKER_INTERVAL=5m
ECOMMERCE_AGENT_WORKER_METRICS_ADDR=127.0.0.1:8081

# API and frontend boundary
ECOMMERCE_API_TOKEN=replace-with-api-token-or-leave-blank-for-local-only
ECOMMERCE_ALLOWED_ORIGIN=http://127.0.0.1:3000
MC_API_BASE_URL=http://mc-api:8080
FLEET_AI_BRIDGE_URL=

# Browser security headers are enforced at the reverse proxy/CDN/frontend layer.
ECOMMERCE_CSP_CONNECT_SRC=http://127.0.0.1:3000 http://127.0.0.1:8080
ECOMMERCE_CSP_REPORT_URI=

# WooCommerce integration. Keep blank for dry-run/no-op sync.
ECOMMERCE_WC_STORE_URL=
ECOMMERCE_WC_BASE_URL=
ECOMMERCE_WC_CONSUMER_KEY=
ECOMMERCE_WC_CONSUMER_SECRET=
ECOMMERCE_WC_WEBHOOK_SECRET=
ECOMMERCE_SYNC_MODE=once
ECOMMERCE_SYNC_DRY_RUN=true

# AI bridge integration. Do not point directly at MiniMax from app services.
ECOMMERCE_AI_BRIDGE_URL=
ECOMMERCE_AI_MODEL=

# RAG/embedding bridge integration. This may point at the same approved fleet
# bridge as ECOMMERCE_AI_BRIDGE_URL when that bridge exposes embeddings.
ECOMMERCE_EMBEDDING_BRIDGE_URL=
ECOMMERCE_EMBEDDING_MODEL=minimax-embedding-01
ECOMMERCE_EMBEDDING_DIMENSIONS=1536
ECOMMERCE_RAG_CHUNK_SIZE=1000

# Media storage placeholders. Production-like compose does not mount a writable
# filesystem media volume; point these at an object-storage adapter when wired.
ECOMMERCE_MEDIA_STORE=object
ECOMMERCE_MEDIA_BUCKET=
ECOMMERCE_MEDIA_PUBLIC_BASE_URL=

# Compliance gate placeholders for v0.7.0.
ECOMMERCE_COMPLIANCE_MIN_SEO_SCORE=70
ECOMMERCE_COMPLIANCE_MAX_IMAGE_SIZE_BYTES=5242880
ECOMMERCE_COMPLIANCE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Optional minimax-openai-bridge profile placeholders.
MINIMAX_API_KEY_1=
MINIMAX_API_KEY_2=
MINIMAX_BASE_URL=

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password

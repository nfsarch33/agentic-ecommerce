# One file per pilot instance: copy to pilots/<name>.env and fill it in.
# Every value is per-pilot on purpose — two pilots must never share a
# credential, a port or (via the compose project name) a volume.
#
#   scripts/pilot-instance.sh create <name>   stamps this template.
#
# pilots/<name>.env is GITIGNORED: it carries the instance secrets.

# The compose project name: scopes networks, volumes and container names
# to this pilot (own postgres-data volume, own ecommerce network).
COMPOSE_PROJECT_NAME=pilot-NAME

# Own database, own credentials. No pilot may run on the default
# password — the isolation test refuses to start an instance that does.
POSTGRES_DB=pilot_NAME
POSTGRES_USER=pilot_NAME
POSTGRES_PASSWORD=generate-one-per-pilot

# Own loopback ports: every pilot occupies its own host port pair, so a
# mis-pointed client hits a DIFFERENT instance, not a shared one.
BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=55479

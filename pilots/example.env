# One file per pilot instance: copy to pilots/<name>.env and fill it in.
# Every value is per-pilot on purpose — two pilots must never share a
# credential, a port or (via the compose project name) a volume.
#
#   scripts/pilot-instance.sh create <name>   stamps this template.
#
# pilots/<name>.env is GITIGNORED: it carries the instance secrets.

# The compose project name: scopes networks, volumes and container names
# to this pilot (own postgres-data volume, own ecommerce network).
COMPOSE_PROJECT_NAME=pilot-PNAME

# Own database, own credentials. No pilot may run on the default
# password — the isolation test refuses to start an instance that does.
POSTGRES_DB=pilot_PNAME
POSTGRES_USER=pilot_PNAME
POSTGRES_PASSWORD=generate-one-per-pilot

# Own loopback ports: every pilot occupies its own host port pair, so a
# mis-pointed client hits a DIFFERENT instance, not a shared one.
BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=55479
MC_API_HOST_PORT=55480

# The inbox share — the ONE port this pilot publishes off-loopback. Left at
# loopback, nothing is shared and the approver cannot reach the instance.
# To share with the pilot's approver only, set INBOX_BIND_HOST to the
# tailnet interface IP (100.x.y.z — never 0.0.0.0, never the LAN address):
# the inbox port becomes the only port of this project reachable from the
# private network; every other service above stays loopback-bound.
INBOX_BIND_HOST=127.0.0.1
WEB_HOST_PORT=55481

# The inbox share is plain http on the tailnet interface, and the inbox
# container runs in production mode where the session cookie defaults to
# Secure — a Secure cookie over plain http is silently dropped by every
# browser, so the approver could never stay signed in. False is correct
# ONLY while the share is plain http on the private network; the TLS
# front (the go-live item) removes this line.
AUTH_COOKIE_SECURE=false

# The pilot approver's login. Credentials live in this pilot's own postgres
# (mc-api's auth store), so a credential minted here is meaningless on any
# other pilot instance. No pilot may run on the template password.
ECOMMERCE_ADMIN_USERNAME=approver-PNAME@pilot.test
ECOMMERCE_ADMIN_PASSWORD=generate-one-per-pilot

# Token signing, per pilot (at least 32 chars): mc-api fails closed on
# auth without a usable secret, and a shared secret would let a token
# minted by one pilot's inbox pass another pilot's API.
ECOMMERCE_JWT_SECRET=generate-one-per-pilot-too

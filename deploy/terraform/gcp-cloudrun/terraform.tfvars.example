# Placeholder-only values for local QA dry-runs.
# Replace every value outside version control before a real deployment.
project_name                    = "agentic-ecommerce"
environment                     = "qa"
gcp_project_id                  = "example-project"
gcp_region                      = "us-central1"
vpc_connector_cidr              = "203.0.113.0/28"
backend_image                   = "ghcr.io/nfsarch33/agentic-ecommerce"
frontend_image                  = "ghcr.io/nfsarch33/agentic-ecommerce-web"
image_tag                       = "9e3ddb93c559ebb7a34f0d725da7bb9c56a1aba5"
temporal_image                  = "temporalio/temporal"
temporal_image_tag              = "1.26.2"
temporal_namespace              = "default"
temporal_task_queue             = "ec-workflows"
mc_api_min_instances            = 1
mc_api_max_instances            = 20
temporal_worker_min_instances   = 1
temporal_worker_max_instances   = 10
allowed_origin                  = "https://frontend.example.com"
api_token_secret_name           = "agentic-ecommerce-api-token"
postgres_password_secret_name   = "agentic-ecommerce-postgres"
redis_auth_secret_name          = "agentic-ecommerce-redis"
wc_store_url_secret_name        = "agentic-ecommerce-wc-store-url"
wc_consumer_key_secret_name     = "agentic-ecommerce-wc-consumer-key"
wc_consumer_secret_secret_name  = "agentic-ecommerce-wc-consumer-secret"
wc_webhook_secret_name          = "agentic-ecommerce-wc-webhook-secret"
fleet_ai_bridge_url_secret_name = "agentic-ecommerce-fleet-ai-bridge-url"
embedding_bridge_url_secret_name = "agentic-ecommerce-embedding-bridge-url"
media_bucket_name                 = "agentic-ecommerce-qa-media"
media_object_prefix               = "media/"
media_public_base_url             = "https://media.example.com"
media_max_size_bytes              = 5242880
media_allowed_mime_types          = ["image/jpeg", "image/png", "image/webp"]
sync_dry_run                    = true

# Docker Compose dev environment variables.
# Copy to .env and adjust values as needed.

# Bind host for all published ports (default: loopback only)
BIND_HOST=127.0.0.1

# PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5432
ECOMMERCE_DB_URL=postgres://postgres:postgres@127.0.0.1:5432/ecommerce?sslmode=disable
ECOMMERCE_DB_POOL_MAX_CONNS=10
ECOMMERCE_DB_POOL_MIN_CONNS=1
ECOMMERCE_DB_POOL_MAX_CONN_LIFETIME=30m
ECOMMERCE_DB_POOL_MAX_CONN_IDLE_TIME=5m
ECOMMERCE_DB_CONNECT_TIMEOUT=5s

# Redis session/cart cache
REDIS_HOST_PORT=6379
ECOMMERCE_REDIS_ADDR=127.0.0.1:6379
ECOMMERCE_REDIS_DB=0
ECOMMERCE_REDIS_KEY_PREFIX=ec:dev:

# Redis connection pool sizing (v4.1.1 IC-9)
EC_REDIS_POOL_SIZE=10
EC_REDIS_MIN_IDLE_CONNS=2
EC_REDIS_MAX_CONN_AGE_SECONDS=1800

# Postgres statement_timeout (v4.1.0 IC-8)
EC_PG_READ_TIMEOUT_MS=30000
EC_PG_WRITE_TIMEOUT_MS=60000

# Activity HTTP timeout for Temporal activities (v4.1.0 IC-7)
EC_ACTIVITY_HTTP_TIMEOUT_SECONDS=30

# Carrier production API keys (v4.1.0 CF-2)
EC_AUSPOST_API_KEY=
EC_AUSPOST_API_SECRET=
EC_DHL_API_KEY=
EC_DHL_API_SECRET=

# Stripe refund flow (v4.1.0 CF-1)
STRIPE_WEBHOOK_SIGNING_SECRET=
STRIPE_SECRET_KEY=

# Cloud readiness and optional tracing
ECOMMERCE_READINESS_TIMEOUT=2s
ECOMMERCE_REDIS_TIMEOUT=500ms
ECOMMERCE_SHUTDOWN_TIMEOUT=10s
ECOMMERCE_OTEL_ENABLED=false

# Redis Streams event bus (v1.1.0+).
# Driver: "redis" uses Redis Streams with consumer groups for at-least-once delivery.
ECOMMERCE_EVENTBUS_DRIVER=redis
ECOMMERCE_EVENTBUS_REDIS_ADDR=127.0.0.1:6379
ECOMMERCE_EVENTBUS_REDIS_DB=0
ECOMMERCE_EVENTBUS_CONSUMER_GROUP=ec-api-group
ECOMMERCE_EVENTBUS_STREAMS=ec.product.events,ec.order.events,ec.sync.events,ec.agent.events,ec.compliance.events
ECOMMERCE_EVENTBUS_CHANNEL_SYNC=ec.sync.events
ECOMMERCE_EVENTBUS_CHANNEL_DLQ=ec.sync.deadletter

# Temporal local workflow infrastructure (v1.2.0+).
# The compose profile runs a dev-only Temporal server and UI on loopback.
TEMPORAL_IMAGE_TAG=latest
TEMPORAL_GRPC_HOST_PORT=7233
TEMPORAL_UI_HOST_PORT=8233
ECOMMERCE_TEMPORAL_ADDRESS=temporal:7233
ECOMMERCE_TEMPORAL_NAMESPACE=default
ECOMMERCE_TEMPORAL_TASK_QUEUE=ec-workflows
TEMPORAL_WORKER_IMAGE=ghcr.io/nfsarch33/agentic-ecommerce:dev-temporal-worker

# n8n local automation profile (v1.5.0+). Keep loopback-only by default.
N8N_IMAGE_TAG=1.88.0
N8N_HOST_PORT=5678
N8N_HOST=127.0.0.1
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://127.0.0.1:5678/
N8N_WEBHOOK_URL=http://127.0.0.1:5678/
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=UTC
N8N_SLACK_WEBHOOK_URL=
N8N_ORDER_EMAIL_ENDPOINT_URL=

# RAG/embedding pipeline (v1.3.0+). Use the approved fleet bridge only; leave
# the URL blank for deterministic local SQL smokes that do not call embeddings.
ECOMMERCE_EMBEDDING_BRIDGE_URL=
ECOMMERCE_EMBEDDING_MODEL=minimax-embedding-01
ECOMMERCE_EMBEDDING_DIMENSIONS=1536
ECOMMERCE_RAG_CHUNK_SIZE=1000

# Agent scheduler worker. The compose workers profile is opt-in; once enabled,
# these values control the bootstrap agent runtime seam. `legacy` preserves the
# current scheduler path; `shadow` and `primary` stay opt-in until mirrored QA
# evidence promotes each domain.
AGENT_WORKER_METRICS_HOST_PORT=8082
ECOMMERCE_AGENT_WORKER_ENABLED=true
ECOMMERCE_AGENT_WORKER_RUN_ONCE=false
ECOMMERCE_AGENT_WORKER_CONCURRENCY=1
ECOMMERCE_AGENT_WORKER_INTERVAL=5m
ECOMMERCE_AGENT_WORKER_METRICS_ADDR=127.0.0.1:8081
EC_AGENT_RUNTIME_MODE=legacy

# Testing-pool conventions for remote EC lanes. `host-a/node-a` is
# primary-testing; `host-b/node-b` is standby/overflow once controller
# activation gates pass. Override the frontend path on hosts that do not use
# the canonical WSL checkout layout. The backend-owned lane runner reads these
# values when `runx test-lane` dispatches onto a testing pool.
EC_TESTING_POOL_ROLE=primary-testing
EC_FRONTEND_REPO_PATH=/home/jason/Code/agentic-ecommerce-web
EC_STAGING_BASE_URL=
# Optional until the live-AI lane is promoted beyond its explicit
# configuration gate.
EC_TESTING_LIVE_AI_COMMAND=
# Optional until the staging rollback lane is promoted beyond its explicit
# configuration gate.
EC_TESTING_STAGING_ROLLBACK_COMMAND=

# Temporal-backed recurring agent schedules (v1.6.0+). Disabled by default so
# local compose cannot accidentally duplicate manual or worker-triggered runs.
ECOMMERCE_AGENT_SCHEDULES_ENABLED=false
ECOMMERCE_AGENT_SCHEDULES_DEFAULT_INTERVAL=15m
ECOMMERCE_AGENT_SCHEDULES_MAX_CONCURRENT_RUNS=1
ECOMMERCE_AGENT_SCHEDULES_TASK_QUEUE=ec-workflows

# mc-api
MC_API_HOST_PORT=8080
ECOMMERCE_API_TOKEN=
ECOMMERCE_ALLOWED_ORIGIN=

# Browser security headers are enforced at the reverse proxy/CDN/frontend layer.
ECOMMERCE_CSP_CONNECT_SRC=http://127.0.0.1:8080 http://127.0.0.1:3000
ECOMMERCE_CSP_REPORT_URI=

# Local media object storage. `make media-store-seed` and `make media-store-clean` use MEDIA_DIR.
MEDIA_DIR=.local/media-uploads
ECOMMERCE_MEDIA_HOST_DIR=./.local/media-uploads
ECOMMERCE_MEDIA_STORAGE_DRIVER=filesystem
ECOMMERCE_MEDIA_STORE=filesystem
ECOMMERCE_MEDIA_BASE_PATH=/var/lib/agentic-ecommerce/media
ECOMMERCE_MEDIA_ROOT=/var/lib/agentic-ecommerce/media
ECOMMERCE_MEDIA_PUBLIC_BASE_URL=/media
ECOMMERCE_MEDIA_BUCKET=
ECOMMERCE_MEDIA_REGION=
ECOMMERCE_MEDIA_ENDPOINT=
ECOMMERCE_MEDIA_FORCE_PATH_STYLE=false
ECOMMERCE_MEDIA_ACCESS_KEY_ID=
ECOMMERCE_MEDIA_SECRET_ACCESS_KEY=
ECOMMERCE_MEDIA_MAX_SIZE_BYTES=5242880
ECOMMERCE_MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Optional local MinIO profile. Set locally only; never commit real values.
MINIO_IMAGE=quay.io/minio/minio:latest
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Compliance gate placeholders for v0.7.0.
ECOMMERCE_COMPLIANCE_MIN_SEO_SCORE=70
ECOMMERCE_COMPLIANCE_MAX_IMAGE_SIZE_BYTES=5242880
ECOMMERCE_COMPLIANCE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Local WooCommerce test instance (loopback only by default).
WC_DB_IMAGE=mariadb:11.4
WC_DB_NAME=wordpress
WC_DB_USER=wordpress
WC_DB_PASSWORD=wordpress
WC_DB_ROOT_PASSWORD=wordpress-root
WC_DB_HOST_PORT=3307
WC_WORDPRESS_IMAGE=wordpress:php8.3-apache
WC_CLI_IMAGE=wordpress:cli-php8.3
WC_HOST_PORT=8081

# WooCommerce REST API credentials. Leave blank for dry-run sync.
ECOMMERCE_WC_BASE_URL=http://wordpress
ECOMMERCE_WC_CONSUMER_KEY=
ECOMMERCE_WC_CONSUMER_SECRET=
ECOMMERCE_SYNC_MODE=once
ECOMMERCE_SYNC_DRY_RUN=auto

# Build args
VERSION=dev
COMMIT=unknown

# v3.1.0 EC-1 China Sourcing Agent (Epic 1).
# OMNIPARSER_BRIDGE_URL is REQUIRED in production; the sourcing agent
# refuses to start without it. Point at the omniparser-bridge runx
# alias (resolved via a runx-managed tunnel from the operator laptop to gpu-host-1).
OMNIPARSER_BRIDGE_URL=
# 1688 / Taobao session cookies. v3.1.0 uses env-var stubs; v3.7.0
# (EC-10-1) moves these to the OS keychain.
ECOMMERCE_1688_SESSION_COOKIE=
ECOMMERCE_TAOBAO_SESSION_COOKIE=

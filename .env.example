# Docker Compose dev environment variables.
# Copy to .env and adjust values as needed.

# Bind host for all published ports (default: loopback only)
BIND_HOST=127.0.0.1

# PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5432

# mc-api
MC_API_HOST_PORT=8080
ECOMMERCE_API_TOKEN=
ECOMMERCE_ALLOWED_ORIGIN=

# Build args
VERSION=dev
COMMIT=unknown
